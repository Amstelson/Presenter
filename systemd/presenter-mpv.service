[Unit]
Description=Presenter slideshow player (mpv)
# Not enabled at boot on purpose: the desktop autostart entry
# (presenter-mpv.desktop) starts it once the screen session exists.
# Give up after 10 failed starts in 2 minutes instead of looping forever.
StartLimitIntervalSec=120
StartLimitBurst=10
# Also start the HDMI mode keeper (it exits at once if no mode is set).
Wants=presenter-hdmi.service
# Stays off after Stop Presenter (presenter.sh stop) until Start Presenter.
ConditionPathExists=!%h/.config/presenter/stopped

[Service]
# Defaults, can be overridden in ~/.config/presenter.env
Environment=PRESENTER_FORMAT=flat PRESENTER_SOCKET=/tmp/mpv.sock PRESENTER_DURATION=10
EnvironmentFile=-%h/.config/presenter.env
ExecStartPre=/usr/bin/mkdir -p %h/.config/presenter
ExecStartPre=/usr/bin/touch %h/.config/presenter/player.conf %h/.config/presenter/playlist.m3u8
# --idle/--force-window: keep a black fullscreen window even with no images
# --stop-screensaver=always: no screensaver or screen lock, also when paused
# --profile: frame every image as DCI Flat or Scope (see mpv/formats.conf)
# player.conf and playlist.m3u8 are written by the web app: the seconds per
# slide and the slideshow (switched-on folders and slides, maybe shuffled)
ExecStart=/usr/bin/mpv --fs --idle=yes --force-window=yes \
    --loop-playlist=inf --image-display-duration=${PRESENTER_DURATION} \
    --input-ipc-server=${PRESENTER_SOCKET} \
    --no-osc --osd-level=0 --cursor-autohide=always --no-audio --no-terminal \
    --stop-screensaver=always \
    --include=%h/presenter/mpv/formats.conf --profile=${PRESENTER_FORMAT} \
    --include=%h/.config/presenter/player.conf \
    %h/.config/presenter/playlist.m3u8
Restart=always
RestartSec=3
